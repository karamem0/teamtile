{
  "name": "@karamem0/teamtile",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --coverage",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "stylelint": "stylelint 'src/**/*.{css,scss,jsx,tsx}'",
    "stylelint:fix": "stylelint 'src/**/*.{css,scss,jsx,tsx}' --fix",
    "formatjs:extract": "formatjs extract src/**/messages.ts --out-file src/translations/en.json --id-interpolation-pattern [sha512:contenthash:base64:6] --format simple",
    "formatjs:compile": "npm run formatjs:compile-en && npm run formatjs:compile-ja",
    "formatjs:compile-en": "formatjs compile src/translations/en.json --out-file src/translations/compiled/en.json --ast --format simple",
    "formatjs:compile-ja": "formatjs compile src/translations/ja.json --out-file src/translations/compiled/ja.json --ast --format simple"
  },
  "dependencies": {
    "@automapper/core": "^9.0.2",
    "@automapper/pojos": "^9.0.2",
    "@azure/msal-browser": "^5.29.0",
    "@azure/msal-react": "^5.8.1",
    "@emotion/react": "^11.14.0",
    "@fastify/deepmerge": "^3.2.4",
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-icons": "^2.0.345",
    "@microsoft/applicationinsights-react-js": "^19.4.2",
    "@microsoft/applicationinsights-web": "^3.4.6",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/teams-js": "^2.59.0",
    "dexie": "^4.4.7",
    "jwt-decode": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-intl": "^12.1.7",
    "react-router": "^8.5.1",
    "react-use": "^17.6.1",
    "ress": "^6.0.0"
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.2",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.5",
    "@formatjs/cli": "^6.18.2",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/plugin-emotion": "^20.0.2",
    "@swc/plugin-formatjs": "^15.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-formatjs": "^8.1.4",
    "eslint-plugin-hooks": "^0.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "postcss-styled-syntax": "^0.7.4",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
