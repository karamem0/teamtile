{
  "name": "@karamem0/teamtile",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --coverage",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "stylelint": "stylelint 'src/**/*.{css,scss,jsx,tsx}'",
    "stylelint:fix": "stylelint 'src/**/*.{css,scss,jsx,tsx}' --fix",
    "formatjs:extract": "formatjs extract src/**/messages.ts --out-file src/translations/en.json --id-interpolation-pattern [sha512:contenthash:base64:6] --format simple",
    "formatjs:compile": "npm run formatjs:compile-en && npm run formatjs:compile-ja",
    "formatjs:compile-en": "formatjs compile src/translations/en.json --out-file src/translations/compiled/en.json --ast --format simple",
    "formatjs:compile-ja": "formatjs compile src/translations/ja.json --out-file src/translations/compiled/ja.json --ast --format simple"
  },
  "dependencies": {
    "@automapper/core": "^9.0.2",
    "@automapper/pojos": "^9.0.2",
    "@azure/msal-browser": "^5.18.0",
    "@azure/msal-react": "^5.5.5",
    "@emotion/react": "^11.14.0",
    "@fluentui/react-components": "^9.74.5",
    "@fluentui/react-icons": "^2.0.334",
    "@microsoft/applicationinsights-react-js": "^19.4.1",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/teams-js": "^2.54.0",
    "deepmerge": "^4.3.1",
    "dexie": "^4.4.4",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.7.0",
    "react-intl": "^10.1.20",
    "react-router": "^8.3.0",
    "react-use": "^17.6.1",
    "ress": "^5.0.2"
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.2",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.5",
    "@formatjs/cli": "^6.16.16",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@swc/plugin-emotion": "^14.15.0",
    "@swc/plugin-formatjs": "^9.15.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-formatjs": "^6.4.20",
    "eslint-plugin-hooks": "^0.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "postcss-styled-syntax": "^0.7.2",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
